MainTab:CreateButton({
   Name = "Авто-обход мусорок (Зачистка до молотка)",
   Callback = function()
      task.spawn(function()
         pcall(function()
            local function hasHammer()
               local bp = LocalPlayer:FindFirstChild("Backpack")
               local char = LocalPlayer.Character
               if bp then
                  for _, item in pairs(bp:GetChildren()) do
                     if item.Name:lower():find("hammer") or item.Name:lower():find("молоток") then return true end
                  end
               end
               if char then
                  for _, item in pairs(char:GetChildren()) do
                     if item:IsA("Tool") and (item.Name:lower():find("hammer") or item.Name:lower():find("молоток")) then return true end
                  end
               end
               return false
            end

            if hasHammer() then
               Rayfield:Notify({Title = "Инфо", Content = "У вас уже есть молоток!", Duration = 3})
               return
            end

            local dumpsters = {}
            for _, v in pairs(workspace:GetDescendants()) do
               if v.Name:find("TrashDumpster") or v.Name:find("Dumpster") then
                  local model = v:IsA("Model") and v or (v:IsA("BasePart") and v.Parent)
                  if model and not table.find(dumpsters, model) then
                     table.insert(dumpsters, model)
                  end
               end
            end

            if #dumpsters == 0 then
               Rayfield:Notify({Title = "Ошибка", Content = "Мусорные баки не найдены!", Duration = 3})
               return
            end

            for _, dumpster in ipairs(dumpsters) do
               if hasHammer() then break end

               if dumpster and dumpster.Parent then
                  local char = LocalPlayer.Character
                  local hrp = char and char:FindFirstChild("HumanoidRootPart")
                  
                  if hrp then
                     local pos = dumpster:IsA("BasePart") and dumpster.CFrame or dumpster:GetPivot()
                     hrp.CFrame = pos + Vector3.new(0, 4, 0)
                     task.wait(0.2)
                  end

                  local prompt = dumpster:FindFirstChildOfClass("ProximityPrompt", true)
                  if prompt then
                     fireproximityprompt(prompt)
                     task.wait(0.5)
                  end

                  if hasHammer() then
                     Rayfield:Notify({Title = "Успех!", Content = "Молоток найден!", Duration = 4})
                     break
                  else
                     pcall(function() dumpster:Destroy() end)
                  end
               end
               task.wait(0.2)
            end
         end)
      end)
   end,
})

